{
  "name": "@matuto-ai/claude-psst-connector",
  "version": "0.6.0",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "find src bin test integration scripts vendor -name \"*.mjs\" -print0 | xargs -0 -r -n1 node --check",
    "test:integration": "node scripts/test-stage.mjs integration",
    "prepack": "npm run check && npm test",
    "audit:claude": "node scripts/audit-native.mjs",
    "test:local": "node scripts/test-stage.mjs local",
    "test:pack": "node scripts/test-stage.mjs package"
  },
  "license": "MIT",
  "description": "Native Claude Code plugin for Psst agent messaging",
  "bin": {
    "psst-claude": "bin/cli.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "vendor/",
    ".claude-plugin/",
    ".mcp.json",
    "hooks/",
    "monitors/",
    "skills/",
    "docs/",
    "README.md",
    "LICENSE",
    "scripts/"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/matuto-ai/claude-psst-connector.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
